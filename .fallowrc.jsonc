{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": [
    // Build-time only. globals.css does `@import "tailwindcss"`, which PostCSS
    // resolves during `next build` and compiles away; nothing imports it at
    // runtime. devDependencies is correct, and CI installs all deps before
    // building, so a --prod install never has to resolve it.
    "tailwindcss"
  ],
  "audit": {
    // Three clone groups predate this config and are all deliberate:
    //
    //   resolveAliasNames  scripts/ is Node ESM shared with the API routes and
    //                      reaches for node:fs, so the browser needs its own
    //                      copy in src/ldraw/mpd.ts. Both say so in comments.
    //   the brick predicate  ldraw-analyze.mjs mirrors the packer on purpose,
    //                      as a cross-check that the two agree on what counts
    //                      as a brick. Sharing the code would defeat it.
    //   main().catch(...)  CLI entry-point boilerplate, nine lines of it.
    //
    // Baselining them keeps duplication gating on anything genuinely new,
    // instead of firing whenever one of these files is touched. Refresh with:
    //   pnpm exec fallow dupes --save-baseline .fallow-dupes-baseline.json
    "dupesBaseline": ".fallow-dupes-baseline.json"
  },
  "health": {
    // CRAP is cyclomatic² × (1 − coverage)³ + cyclomatic. There is no test
    // suite here, so coverage is 0 and it collapses to cyclomatic² + cyclomatic,
    // which makes the default ceiling of 30 mean "cyclomatic > 5" - far stricter
    // than the cyclomatic limit actually configured, and reached by accident
    // rather than on purpose. Every finding it produced was a function well
    // inside both real limits.
    //
    // 420 is c² + c at the maxCyclomatic of 20, so while coverage is missing
    // CRAP adds nothing the cyclomatic check does not already say, and the
    // cyclomatic and cognitive limits below do the gating. Point `coverage` at
    // an Istanbul report once there are tests and drop this back to 30, at
    // which point the score starts measuring risk rather than absence.
    "maxCrap": 420
  },
  "rules": {
    // Syntactic analysis cannot see `controllerRef.current?.setModel(...)`, so
    // SceneController's public methods look unused. Running with --type-aware
    // resolves them correctly (3 findings -> 0), which is the check to trust
    // before deleting anything here.
    "unused-class-members": "warn"
  }
}
