{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": [
    // Build-time only. globals.css does `@import "tailwindcss"`, which PostCSS
    // resolves during `next build` and compiles away; nothing imports it at
    // runtime. devDependencies is correct, and CI installs all deps before
    // building, so a --prod install never has to resolve it.
    "tailwindcss"
  ],
  // Captured third-party markup, kept verbatim so the parser is tested against
  // the real thing. Nothing in it is ours to lint.
  "ignorePatterns": ["scripts/lib/__fixtures__/**"],
  "audit": {
    // Three clone groups predate this config and are all deliberate:
    //
    //   resolveAliasNames  scripts/ is Node ESM shared with the API routes and
    //                      reaches for node:fs, so the browser needs its own
    //                      copy in src/ldraw/mpd.ts. Both say so in comments.
    //   the brick predicate  ldraw-analyze.mjs mirrors the packer on purpose,
    //                      as a cross-check that the two agree on what counts
    //                      as a brick. Sharing the code would defeat it.
    //   main().catch(...)  CLI entry-point boilerplate, nine lines of it.
    //
    // Unlike complexity and dead code, duplication is not attributed as new or
    // inherited, so without this it fires whenever a pull request happens to
    // touch one of those files. Refresh with:
    //   pnpm exec fallow dupes --save-baseline .fallow-dupes-baseline.json
    "dupesBaseline": ".fallow-dupes-baseline.json"
  },
  "health": {
    // CRAP is cyclomatic² × (1 − coverage)³ + cyclomatic, so without coverage
    // it collapses to cyclomatic² + cyclomatic and the default ceiling of 30
    // quietly means "cyclomatic > 5", far stricter than the cyclomatic limit
    // actually configured. It spent a while raised to 420 for exactly that
    // reason. With `pnpm test` feeding it real numbers the score measures risk
    // again, so the default stands.
    //
    // The path is relative to this file and regenerated by the audit script,
    // which runs the suite with coverage first. Functions the report does not
    // cover fall back to an estimate from export references.
    "coverage": "coverage/coverage-final.json",
    "maxCrap": 30
  },
  "rules": {
    // Syntactic analysis cannot see `controllerRef.current?.setModel(...)`, so
    // SceneController's public methods look unused. Running with --type-aware
    // resolves them correctly (3 findings -> 0), which is the check to trust
    // before deleting anything here.
    "unused-class-members": "warn"
  }
}
