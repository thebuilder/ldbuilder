{
  "name": "ldbuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "pnpm run test:coverage && fallow audit",
    "build": "next build",
    "check": "ultracite check",
    "dev": "next dev",
    "fix": "ultracite fix",
    "ldraw:colors": "node scripts/gen-colors.mjs",
    "ldraw:demos": "node scripts/make-demos.mjs",
    "ldraw:index": "node scripts/fetch-omr-index.mjs",
    "ldraw:omr": "node scripts/fetch-omr.mjs",
    "ldraw:pack": "node scripts/pack-models.mjs",
    "ldraw:palette": "node scripts/pack-palette.mjs",
    "ldraw:setup": "node scripts/setup-ldraw.mjs",
    "notices": "node scripts/gen-notices.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@oddbird/popover-polyfill": "^0.7.2",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "nuqs": "2.10.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@tailwindcss/postcss": "4.1.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.185.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fallow": "3.19.0",
    "happy-dom": "^20.11.8",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "ultracite": "7.10.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
